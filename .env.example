# Copiá este archivo como ".env" y completá los valores
# El archivo .env NUNCA se sube a GitHub (está en .gitignore)

# Token de seguridad para la API — generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=pega_aqui_tu_token_generado

# Supabase (compartido entre Railway y Render)
# En Supabase: Project Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Usar la key service_role (lee Y escribe datos)
SUPABASE_KEY=tu_service_role_key

# Puerto local (opcional, por defecto 3000)
# PORT=3000
